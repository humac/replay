# Caddy reverse proxy for the replay stack.
#
# Why: FastAPI/uvicorn serving every HLS .ts segment becomes the bottleneck
# before disk or ffmpeg do, especially on a 10 GbE LAN. Caddy's file_server
# uses sendfile() and easily saturates 10 GbE on segment reads.
#
# Routing:
#   - VOD HLS segments + variant playlists  → served as static files from
#     /data/videos/<match>/hls/ (the same directory the replay app writes to).
#     The replay container's data volume is mounted read-only here.
#   - Everything else (including /api/live/hls/* which proxies MediaMTX, the
#     SPA shell, /api/admin/*, MP4 downloads, settings PUTs) → reverse-proxied
#     to the replay app on the internal compose network at replay:8090.
#
# Ports:
#   - Caddy listens on :80 inside its container.
#   - The compose file publishes that as 8090 on the host (8090:80) so the
#     stack remains reachable at the same `:8090` address it always was —
#     existing Cloudflare Tunnel rules, bookmarks, and the
#     MEDIAMTX → replay:8090 internal call all keep working.
#   - The replay app no longer publishes its own port; it sits on the
#     internal compose network only. Caddy is the single public entry point.
#
# Note: The .ts/.m4s/.mp4 segments are content-addressed (immutable), so we
# slap a 1-year cache header on them. Variant + master playlists revalidate
# every 60s — same policy the replay app applies for the same files. Caddy
# serving them is faster but the headers must match.
#
# TLS: This file targets the in-LAN case (plain HTTP). For WAN, run behind
# Cloudflare Tunnel or front this with a TLS terminator. Don't enable Caddy's
# automatic HTTPS in homelab unless you've fronted DNS-01 with your provider.

{
	auto_https off
	admin off
	# Larger body limit for chunked uploads — must match max_upload_size_bytes
	# in the replay settings table (default 12 GiB).
	servers {
		max_header_size 64KB
	}
}

:80 {
	encode zstd gzip

	# ---- VOD HLS direct serve (the hot path) ----
	# Match: /api/matches/{match_id}/hls/{slot}/...
	#
	# Split into two matchers so we can emit the right Content-Type
	# per format. Caddy's built-in MIME table maps `.ts` to
	# `text/vnd.trolltech.linguist` (Qt translation files) — wrong for
	# MPEG-TS HLS segments, and most players are forgiving so playback
	# works anyway, but the header should match what the replay app
	# emits (video/mp2t for .ts, video/mp4 for .m4s/.mp4 fMP4 segments).
	@vod_hls_segment_ts {
		path_regexp vod_hls_ts ^/api/matches/([^/]+)/hls/([^/]+)/(.+\.ts)$
	}
	handle @vod_hls_segment_ts {
		# Strip the API prefix to map onto the on-disk layout.
		# /api/matches/X/hls/Y/Z.ts  →  /videos/X/hls/Y/Z.ts
		rewrite * /videos/{re.vod_hls_ts.1}/hls/{re.vod_hls_ts.2}/{re.vod_hls_ts.3}
		header Cache-Control "public, max-age=31536000, immutable"
		header Access-Control-Allow-Origin "*"
		header Content-Type "video/mp2t"
		root * /data
		file_server {
			precompressed br gzip
		}
	}

	@vod_hls_segment_mp4 {
		path_regexp vod_hls_mp4 ^/api/matches/([^/]+)/hls/([^/]+)/(.+\.(m4s|mp4))$
	}
	handle @vod_hls_segment_mp4 {
		rewrite * /videos/{re.vod_hls_mp4.1}/hls/{re.vod_hls_mp4.2}/{re.vod_hls_mp4.3}
		header Cache-Control "public, max-age=31536000, immutable"
		header Access-Control-Allow-Origin "*"
		header Content-Type "video/mp4"
		root * /data
		file_server {
			precompressed br gzip
		}
	}

	@vod_hls_playlist {
		path_regexp vod_hls_pl ^/api/matches/([^/]+)/hls/([^/]+)/(.+\.m3u8)$
	}
	handle @vod_hls_playlist {
		rewrite * /videos/{re.vod_hls_pl.1}/hls/{re.vod_hls_pl.2}/{re.vod_hls_pl.3}
		header Cache-Control "public, max-age=60, must-revalidate"
		header Access-Control-Allow-Origin "*"
		header Content-Type "application/vnd.apple.mpegurl"
		root * /data
		file_server
	}

	# ---- Match thumbnails → static serve from /data ----
	# The season view fetches a thumbnail per match card (typically 6+ images
	# on first paint). Going through uvicorn was ~80 ms per file; Caddy's
	# sendfile-based file_server brings each one to <5 ms. The replay app
	# still owns the regenerate-thumbnail admin endpoint; only the public
	# GET is short-circuited here.
	@match_thumbnail {
		path_regexp match_thumb ^/api/matches/([^/]+)/thumbnail/?$
	}
	handle @match_thumbnail {
		rewrite * /videos/{re.match_thumb.1}/thumb.jpg
		header Cache-Control "no-cache, must-revalidate"
		header Access-Control-Allow-Origin "*"
		header Content-Type "image/jpeg"
		root * /data
		file_server
	}

	# ---- SPA static assets (script.js, styles.css, js/*, logo.png) ----
	# Replay's lifespan startup populates /srv/static from /app on the replay
	# container; Caddy mounts the same named volume read-only here. Same
	# sendfile() benefit as HLS — uvicorn was paying Python per-request
	# overhead on every JS module fetch.
	#
	# `handle_path /static/*` strips the /static/ prefix so file_server
	# resolves against the export root directly. Adding a new SPA asset
	# also requires adding it to `_STATIC_EXPORT_PATHS` in server.py;
	# otherwise Caddy will 404 it (loud, easy to diagnose).
	handle_path /static/* {
		# 60s revalidation matches the production HLS-playlist policy and
		# keeps in-session navigation fast while still picking up new
		# bundles after a deploy. ETags (mtime-based) drive 304s.
		header Cache-Control "public, max-age=60, must-revalidate"
		root * /srv/static
		file_server {
			precompressed br gzip
		}
	}

	# ---- Everything else → replay app ----
	handle {
		reverse_proxy replay:8090 {
			# Stream video bodies without buffering the whole upload into RAM.
			flush_interval -1
			transport http {
				read_buffer 64KB
				write_buffer 64KB
			}
			# Preserve the original Host header so the app sees
			# f2014steel.jvhlabs.com (not the upstream `replay:8090`).
			# X-Forwarded-For / X-Forwarded-Proto are set automatically by
			# Caddy's reverse_proxy and don't need to be repeated here;
			# X-Real-IP is unused by streams.client_ip() (which prefers
			# CF-Connecting-IP / True-Client-IP / XFF), so we drop it too.
			header_up Host {host}
		}
	}

	log {
		output stdout
		format console
		level INFO
	}
}
