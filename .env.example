# Copy this file to .env.local and adjust values for your environment.

# App auth — ADMIN_PASS is required; the server refuses to start if it is unset.
ADMIN_USER=admin
ADMIN_PASS=change-me
MAX_ACTIVE_TOKENS=1000

# App server
REPLAY_PORT=8090
REPLAY_DATA_DIR=/data

# Uploads and processing
MAX_UPLOAD_SIZE_BYTES=12884901888
UPLOAD_CHUNK_SIZE_BYTES=16777216
# Number of matches that can transcode in parallel. Each match spawns up to
# 3 ffmpeg processes (one per HLS variant). With GPU encoding via VAAPI or
# NVENC the limit is iGPU/GPU session count, not CPU — 3 is a reasonable
# default on modern Intel iGPUs (Iris Xe and newer) and any NVIDIA GPU.
# Drop to 2 (or 1) if you're CPU-only.
TRANSCODE_CONCURRENCY=3
VIDEO_STREAM_CHUNK_BYTES=1048576
HLS_SEGMENT_DURATION=6
MIN_FREE_DISK_BYTES=21474836480
UPLOAD_DISK_HEADROOM_MULTIPLIER=2.2
STALE_UPLOAD_SESSION_SECONDS=21600

# Runtime temp directory
TMPDIR=/tmp/ffmpeg

# Hardware acceleration — auto / nvenc / vaapi / cpu. "auto" picks vaapi
# when /dev/dri/renderD128 is present in the container, otherwise nvenc.
# Override only if auto-detection picks the wrong path on a mixed host.
REPLAY_HWACCEL=auto

# Optional NVIDIA container settings
NVIDIA_VISIBLE_DEVICES=GPU-26ddab77-c658-9829-0ace-90674c97dc87
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# Intel iGPU (VAAPI / QSV) — only used by docker-compose-intel.yml.
# Numeric GIDs of the host's video and render groups. The `render` group's
# GID varies by distro, so look it up on your host:
#   VIDEO_GID=$(stat -c '%g' /dev/dri/card0)
#   RENDER_GID=$(stat -c '%g' /dev/dri/renderD128)
# Defaults below match Debian/Ubuntu + a common render GID.
VIDEO_GID=44
RENDER_GID=107

# Proxy trust mode for IP resolution (affects login rate-limit and stream tracking).
# "cloudflare" (default): trust CF-Connecting-IP / X-Forwarded-For headers.
# "none": ignore proxy headers; use the direct peer address.
# Set to "none" for bare deployments not behind Cloudflare or a trusted proxy.
TRUSTED_PROXY=cloudflare

# Shared secret MediaMTX sends in X-Internal-Secret when calling /api/live/auth.
# Set in mediamtx.yml under authHTTPHeaders: {X-Internal-Secret: "your-secret"}.
# If unset, replay fails closed with 503 by default. Set
# LIVE_AUTH_ALLOW_INSECURE=1 only for local/dev firewalled scenarios.
LIVE_AUTH_SECRET=
LIVE_AUTH_ALLOW_INSECURE=0

# Live streaming — stale-publisher detection threshold. Status flips to
# offline when no new HLS segment has been cut for this many seconds,
# even if the RTMP socket is still open. Default 90; lower for faster
# offline detection on stable cameras, higher for cameras on bad uplinks.
LIVE_STALE_SEGMENT_AGE_SECONDS=90

# Cloudflare DDNS sidecar — keeps the RTMP A record
# (f2014steel-live.jvhlabs.com by default) pointing at the current public
# IP. Token needs the "Edit zone DNS" permission scoped to the relevant
# zone. Only required if you start the cloudflare-ddns service in
# docker-compose.yml.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here